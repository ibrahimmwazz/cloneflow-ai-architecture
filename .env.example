# CloneFlow AI - Environment Configuration
# Copy this file to .env and fill in your values. Never commit real credentials.

# ===========================================
# Application
# ===========================================
APP_NAME=CloneFlow AI
DEBUG=false
ENVIRONMENT=development
API_BASE_URL=https://ai-clone.fly.dev
APP_URL=https://ai-clone-tan-six.vercel.app

# ===========================================
# Security (Generate strong random values)
# python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================
WORKER_SECRET=replace-with-secure-random-hex

# ===========================================
# Supabase (Database, Auth & pgvector RAG)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# Redis (Upstash Queue & SSE Pub/Sub)
# ===========================================
REDIS_URL=rediss://default:<your-redis-password>@<your-redis-host>.upstash.io:6379
REDIS_TOKEN=your-upstash-rest-token

# ===========================================
# LLMs, RAG & Embeddings
# ===========================================
GROQ_API_KEY=your-groq-api-key
HF_TOKEN=your-huggingface-token
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4

# ===========================================
# Modal (Serverless GPU Workers)
# ===========================================
MODAL_WORKER_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_job
MODAL_IMGGEN_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_image_gen
MODAL_VIDGEN_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_video_gen
MODAL_HUNYUAN_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_hunyuan_video
MODAL_DUBBING_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_dubbing
MODAL_STITCH_URL=https://your-modal-app--cloneflow-worker-web.modal.run/trigger_stitch_video

# ===========================================
# Cloudflare R2 (Object Storage)
# ===========================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=cloneflow-videos
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# ===========================================
# Billing, Voice & Observability (Optional)
# ===========================================
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_CREDITS=price_your-price-id
ELEVENLABS_API_KEY=your-elevenlabs-key
SILICONFLOW_API_KEY=your-siliconflow-key
SENTRY_DSN=
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
